# Copie este arquivo para .env e ajuste os valores conforme o ambiente local.
# O .env não é versionado (ver .gitignore).

# Conexão com o PostgreSQL local (docker compose up -d db)
DATABASE_URL="postgresql://gamelog:gamelog@localhost:5432/gamelog?schema=public"

# Banco dedicado aos testes (opcional). Por padrão, os testes usam a DATABASE_URL com o
# nome do banco acrescido de "_test" (ex.: gamelog_test), criado e migrado automaticamente;
# o banco apontado por DATABASE_URL não é alterado. O nome do banco de testes precisa
# terminar em "_test".
# TEST_DATABASE_URL="postgresql://gamelog:gamelog@localhost:5432/gamelog_test?schema=public"

# Servidor HTTP
NODE_ENV="development"
HOST="0.0.0.0"
PORT="3000"

# Log (fatal | error | warn | info | debug | trace | silent) e CORS
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:5173"

# Documentação OpenAPI (Swagger UI em http://localhost:3000/docs)
OPENAPI_ENABLED="true"

# Segredos JWT (RN-F1-13): mínimo de 32 caracteres cada e obrigatoriamente diferentes.
# Gere valores aleatórios para o seu .env (ex.: openssl rand -hex 32).
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso-por-um-valor-aleatorio-de-32+"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-por-um-valor-aleatorio-de-32+"

# Administrador inicial criado por `npm run db:seed` (RN-F1-14).
# Usados apenas pelo seed; não há endpoint público de criação de ADMIN.
ADMIN_EMAIL="admin@gamelog.local"
ADMIN_USERNAME="gamelog_admin"
ADMIN_PASSWORD="troque-esta-senha-do-admin-1"
