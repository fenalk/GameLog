// Schema do banco de dados do GameLog (PostgreSQL).
//
// Etapa 0 (Fundação): este arquivo define apenas a base da camada de persistência.
// Etapa 1 (Identidade e acesso — F1): usuários e refresh tokens (SPEC F1).
// Etapa 1 (Identidade e acesso — F2): campos de perfil do usuário (SPEC F2).
// Etapa 2 (Catálogo de jogos — F3): jogos e taxonomias com as relações N:N (SPEC F3,
// seção 1). Os campos exclusivos de F4–F7 serão acrescentados pelas migrations das
// respectivas funcionalidades.
// Etapa 3 (Atividade do jogador — F8): diário de jogos jogados (SPEC F8, seção 1).
// Etapa 3 (Atividade do jogador — F10): resenhas (SPEC F10, seção 1).
// Etapa 4 (Listas — F11): listas de jogos e seus itens (SPEC F11, seção 1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Papéis de acesso (seção 1 da SPEC F1). O Visitante é a ausência de token.
enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Classificação do registro no diário (seção 1 da SPEC F8). É apenas uma classificação:
/// não há transições obrigatórias nem acoplamento com as datas (RN-F8-03).
enum GameLogStatus {
  PLAYING
  COMPLETED
  ON_HOLD
  DROPPED
  BACKLOG
}

/// Visibilidade da resenha (seção 1 da SPEC F10). A F10 cria sempre `PUBLISHED`; as
/// transições (`HIDDEN`/`REMOVED`) pertencem à moderação da F14.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

/// Visibilidade da lista (seção 1 da SPEC F11). `PUBLIC` é lida por qualquer pessoa;
/// `PRIVATE` só pelo dono autenticado (RN-F11-05).
enum ListVisibility {
  PUBLIC
  PRIVATE
}

/// Conta de usuário (seção 3 da SPEC F1). `username` e `email` são persistidos já
/// normalizados (minúsculos, sem espaços) e comparados de forma única. Os campos de
/// perfil são nulos por padrão (RN-F2-02): `displayName` nulo é exibido como o
/// `username` e `bio`/`avatarUrl` nulos significam "não informado".
model User {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique @db.VarChar(30)
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  displayName   String?        @map("display_name") @db.VarChar(50)
  bio           String?        @db.VarChar(300)
  avatarUrl     String?        @map("avatar_url") @db.VarChar(500)
  role          Role           @default(PLAYER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens RefreshToken[]
  gameLogs      GameLog[]
  reviews       Review[]
  gameLists     GameList[]

  @@map("users")
}

/// Sessão de refresh (RN-F1-09): guarda apenas o hash do `jti` do JWT, a expiração e a
/// revogação. A rotação e a detecção de reuso usam `jtiHash` + `revokedAt` (RN-F1-10).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  jtiHash   String    @unique @map("jti_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Jogo do catálogo (seção 1 da SPEC F3). A leitura pública e a busca são da F3; a
/// criação, edição e exclusão são da F4. Os agregados de avaliação são mantidos pela F9
/// e permanecem nulos/zero até lá (RN-F3-06).
model Game {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(160)
  title         String    @db.VarChar(150)
  description   String?
  releaseDate   DateTime? @map("release_date") @db.Date
  coverUrl      String?   @map("cover_url") @db.VarChar(500)
  ratingAverage Float?    @map("rating_average") @db.Real
  ratingCount   Int       @default(0) @map("rating_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  genres        GameGenre[]
  platforms     GamePlatform[]
  developers    GameDeveloper[]
  gameLogs      GameLog[]
  reviews       Review[]
  listItems     GameListItem[]

  @@map("games")
}

/// Gênero (SPEC F3, seção 1; gestão na F5). O `slug` é usado nos filtros e nas URLs;
/// `name_normalized` garante unicidade sem diferenciar caixa/acentos (RN-F5-02).
model Genre {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @db.VarChar(50)
  nameNormalized String      @unique @map("name_normalized") @db.VarChar(50)
  slug           String      @unique @db.VarChar(60)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  games          GameGenre[]

  @@map("genres")
}

/// Plataforma (SPEC F3, seção 1; gestão na F6). O `slug` é usado nos filtros e nas URLs;
/// `name_normalized` garante unicidade sem diferenciar caixa/acentos (RN-F6-02).
model Platform {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(60)
  nameNormalized String         @unique @map("name_normalized") @db.VarChar(60)
  slug           String         @unique @db.VarChar(70)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  games          GamePlatform[]
  gameLogs       GameLog[]

  @@map("platforms")
}

/// Desenvolvedora (SPEC F3, seção 1; gestão na F7). O `slug` é usado nos filtros e nas
/// URLs; `name_normalized` garante unicidade sem diferenciar caixa/acentos (RN-F7-02).
model Developer {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(100)
  nameNormalized String          @unique @map("name_normalized") @db.VarChar(100)
  slug           String          @unique @db.VarChar(110)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  games          GameDeveloper[]

  @@map("developers")
}

/// Relação N:N jogo ↔ gênero (seção 1 da SPEC F3).
model GameGenre {
  gameId  String @map("game_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid
  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
  @@map("game_genres")
}

/// Relação N:N jogo ↔ plataforma (seção 1 da SPEC F3).
model GamePlatform {
  gameId     String   @map("game_id") @db.Uuid
  platformId String   @map("platform_id") @db.Uuid
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([gameId, platformId])
  @@index([platformId])
  @@map("game_platforms")
}

/// Relação N:N jogo ↔ desenvolvedora (seção 1 da SPEC F3).
model GameDeveloper {
  gameId      String    @map("game_id") @db.Uuid
  developerId String    @map("developer_id") @db.Uuid
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@id([gameId, developerId])
  @@index([developerId])
  @@map("game_developers")
}

/// Registro do diário (seção 1 da SPEC F8): um único registro por par jogador↔jogo
/// (RN-F8-02), com status, datas, tempo jogado e plataforma opcional. As cascatas
/// (RN-F8-12) removem os registros quando a conta ou o jogo é excluído e apenas
/// desvinculam a plataforma quando ela é excluída.
model GameLog {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  gameId          String        @map("game_id") @db.Uuid
  status          GameLogStatus
  startedAt       DateTime?     @map("started_at") @db.Date
  finishedAt      DateTime?     @map("finished_at") @db.Date
  playtimeMinutes Int?          @map("playtime_minutes")
  platformId      String?       @map("platform_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform        Platform?     @relation(fields: [platformId], references: [id], onDelete: SetNull)

  @@unique([userId, gameId])
  @@index([userId, updatedAt])
  @@index([gameId])
  @@map("game_logs")
}

/// Resenha de um jogo (seção 1 da SPEC F10): uma única resenha por par jogador↔jogo
/// (RN-F10-02), com título, corpo em texto puro e status de visibilidade. As cascatas
/// (RN-F10-16) removem a resenha quando a conta ou o jogo é excluído.
model Review {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  gameId    String       @map("game_id") @db.Uuid
  title     String       @db.VarChar(120)
  body      String       @db.Text
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("reviews")
}

/// Lista de jogos criada pelo jogador (seção 1 da SPEC F11): reúne jogos sob um critério
/// próprio, com ordem manual e visibilidade própria. Não há unicidade de título (títulos
/// iguais geram listas distintas) e a exclusão da conta (RN-F11-18) remove as listas.
model GameList {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  title       String         @db.VarChar(80)
  description String?        @db.VarChar(500)
  visibility  ListVisibility @default(PUBLIC)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       GameListItem[]

  @@index([userId, updatedAt])
  @@index([visibility])
  @@map("game_lists")
}

/// Item de uma lista (seção 1 da SPEC F11): um jogo aparece no máximo uma vez por lista
/// (`UNIQUE (list_id, game_id)`), com posição densa mantida pelo serviço e nota opcional.
/// Excluir o jogo (F4) remove os itens vinculados sem remover as listas (RN-F11-18).
model GameListItem {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  position  Int
  note      String?  @db.VarChar(280)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  list      GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
  @@index([listId, position])
  @@map("game_list_items")
}
