# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# O .env não é versionado (ver .gitignore).

# URL base da API REST consumida pelo frontend.
# Em desenvolvimento, o padrão já funciona via proxy /api (ver vite.config.ts).
VITE_API_URL="/api/v1"

# Destino do proxy /api do servidor de desenvolvimento.
VITE_API_PROXY_TARGET="http://localhost:3000"
